{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "windows",
      "hidden": true,
      "inherits": "base",
      "architecture": "x64",
      "cacheVariables": { "VCPKG_TARGET_TRIPLET": "x64-windows-static-md" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "mac",
      "hidden": true,
      "inherits": "base",
      "generator": "Unix Makefiles",
      "cacheVariables": { "CMAKE_OSX_DEPLOYMENT_TARGET": "15.0" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "win-debug",
      "displayName": "Windows Debug (MSVC)",
      "inherits": "windows",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "win-release",
      "displayName": "Windows Release (MSVC)",
      "inherits": "windows",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "mac-debug",
      "displayName": "macOS Debug (Apple clang)",
      "inherits": "mac",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "mac-release",
      "displayName": "macOS Release (Apple clang)",
      "inherits": "mac",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "mac-asan",
      "displayName": "macOS ASan + UBSan (Apple clang)",
      "inherits": "mac",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "GENESIS_SANITIZE": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "win-debug", "configurePreset": "win-debug", "configuration": "Debug" },
    { "name": "win-release", "configurePreset": "win-release", "configuration": "Release" },
    { "name": "mac-debug", "configurePreset": "mac-debug" },
    { "name": "mac-release", "configurePreset": "mac-release" },
    { "name": "mac-asan", "configurePreset": "mac-asan" }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    { "name": "win-debug", "inherits": "test-base", "configurePreset": "win-debug", "configuration": "Debug" },
    { "name": "win-release", "inherits": "test-base", "configurePreset": "win-release", "configuration": "Release" },
    { "name": "mac-debug", "inherits": "test-base", "configurePreset": "mac-debug" },
    { "name": "mac-release", "inherits": "test-base", "configurePreset": "mac-release" },
    { "name": "mac-asan", "inherits": "test-base", "configurePreset": "mac-asan" }
  ]
}
